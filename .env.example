NODE_ENV=production
HOST=0.0.0.0
PORT=3000
# Comma-separated web origins, only needed for a browser client.
# CORS_ORIGIN=https://app.example.com
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
# Optional: enables live phishing/malware reputation lookups for every URL.
# WEB_RISK_API_KEY=
# Optional: enables bounded message decisioning after OTP/card-like values are redacted.
# TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest
